# Bu dosyayı `.env` olarak kopyalayın. Gerçek sırları repoya eklemeyin.

# Zorunlu: PostgreSQL bağlantısı
# Yerel örnek:
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/randevu_takvim?schema=public"
# Neon örneği:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Halka açık uygulama adresi. SEO, e-posta ve yönlendirmelerde kullanılacaktır.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# İsteğe bağlı, varsayılan: RandevuTakvim
NEXT_PUBLIC_APP_NAME="RandevuTakvim"
